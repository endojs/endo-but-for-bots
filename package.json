{
  "name": "endo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=16"
  },
  "packageManager": "npm@10.9.8",
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@babel/generator": "7.28.3",
    "@babel/parser": "7.28.3",
    "@babel/traverse": "7.28.3",
    "@babel/types": "7.28.2",
    "@endo/compartment-mapper": "^2.3.0",
    "@endo/eslint-plugin": "^2.6.0",
    "@endo/marshal": "^1.10.0",
    "@endo/nat": "^5.2.0",
    "@endo/ses-ava": "^1.4.2",
    "@jessie.js/eslint-plugin": "^0.4.3",
    "@lavamoat/allow-scripts": "^3.4.3",
    "@lavamoat/preinstall-always-fail": "^2.1.1",
    "@types/eslint": "^8.56.12",
    "@types/node": "^20.19.41",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "ava": "^8.0.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-jessie": "^0.0.6",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "npm:eslint-plugin-import-x@4.16.2",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "fast-check": "4.8.0",
    "prettier": "^3.8.3",
    "ses": "^2.2.0",
    "source-map": "^0.7.6",
    "ts-node-pack": "^0.3.5",
    "tsd": "^0.33.0",
    "type-coverage": "^2.29.7",
    "typedoc": "^0.28.19",
    "typedoc-plugin-mermaid": "^1.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0",
    "yaml": "^2.9.0",
    "zx": "^8.8.5"
  },
  "scripts": {
    "clean": "git clean -fX -e node_modules",
    "docs": "rm -rf api-docs packages/ses/dist && typedoc && ./scripts/posttypedoc.sh",
    "update": "echo 'DEPRECATED: use \"npm update\" or \"npm dedupe\"'",
    "format": "prettier --write .github packages",
    "lint": "npm run lint:prettier && npm run lint:eslint && npm run lint:sh",
    "lint:eslint": "eslint .",
    "lint:workspaces": "prettier --check .github packages && npm run lint --workspaces --if-present",
    "lint:workspaces:eslint": "npm run lint:eslint --workspaces --if-present",
    "lint:fix": "npm run lint:eslint -- --fix",
    "lint:workspaces:fix": "npm run lint-fix --workspaces --if-present",
    "lint:prettier": "prettier --check .github packages",
    "lint:sh": "scripts/shellcheck.sh",
    "release:npm": "scripts/release-npm.mjs",
    "pack:all": "scripts/pack-all.mjs",
    "smoketest:publish": "scripts/smoketest-publishing.sh",
    "test": "node scripts/run-workspaces.mjs test @endo/skel",
    "test:c8": "npm run test:c8 --workspaces --if-present",
    "test:xs": "npm run test:xs --workspaces --if-present",
    "test262": "npm run test262 --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build-ts": "tsc --build tsconfig.build.json",
    "build:types:gen": "node scripts/generate-composite-tsconfigs.mjs",
    "build:types:check": "node scripts/generate-composite-tsconfigs.mjs --check",
    "build:types": "tsc --build tsconfig.composite.json",
    "build:types:clean": "npm run build:types -- --clean",
    "build:types:watch": "npm run build:types -- --watch"
  },
  "prettier": {
    "arrowParens": "avoid",
    "singleQuote": true
  },
  "typeCoverage": {
    "atLeast": 0
  },
  "eslintConfig": {
    "root": true
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false
    }
  }
}
