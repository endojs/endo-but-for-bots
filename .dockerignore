# Keep the daemon self-hosting build context lean (docker/Dockerfile).
# The image runs `yarn install` itself, so pre-existing install artifacts and
# build output only bloat the context and can leak host-specific state.
node_modules
**/node_modules
.yarn/cache
.yarn/install-state.gz
.yarn/unplugged
.yarn/build-state.yml
.pnp.*
api-docs
**/dist
**/tmp
**/*.log
.git
target
rust/**/target

# Never bake credentials or local secrets into an image layer (COPY . . copies
# the whole workspace). Match at the context root AND every nested directory —
# a bare `*.pem` excludes only a root-level file, so a monorepo
# `packages/*/server.key` or `packages/*/.env` would otherwise slip through.
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
*.p12
**/*.pem
**/*.key
**/*.p12
**/.npmrc
