Mutant SNAP-4-b: prefixed_len drops one header byte.
--- a/ironhorse-vm/src/opcode.rs
+++ b/ironhorse-vm/src/opcode.rs
@@ -1116,7 +1116,7 @@
 /// `wasm32`, as well as the 64-bit one.
 #[inline]
 fn prefixed_len<W: TryFrom<u64>>(header: u8, payload: u32) -> Option<W> {
