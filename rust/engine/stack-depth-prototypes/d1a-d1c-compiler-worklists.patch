+/// E3 prototype: tear a tree down with a heap worklist instead of the
+/// recursive drop glue (one host frame chain per tree level).
+impl Drop for Node {
+    fn drop(&mut self) {
+        if self.children.is_empty() {
+            return;
+        }
+        let mut stack = std::mem::take(&mut self.children);
+        while let Some(item) = stack.pop() {
+            match item {
+                Item::Node(mut n) => stack.append(&mut n.children),
+                Item::List(mut v) => stack.append(&mut v),
+                Item::Symbol(_) | Item::Null => {}
+            }
+        }
+    }
+}
