{
  "name": "@endo/daemon",
  "version": "3.0.0",
  "private": true,
  "description": "Endo daemon",
  "keywords": [
    "endo",
    "daemon"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/blob/master/packages/daemon/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/daemon"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./index.js"
    },
    "./ref-reader.js": "./ref-reader.js",
    "./reader-ref.js": "./reader-ref.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "cover": "c8 ava --config test/_ava-ses.config.js",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint-fix": "eslint --fix .",
    "lint:eslint": "eslint .",
    "lint:types": "tsc",
    "test": "ava",
    "test:clean": "rm -rf tmp && npm run test"
  },
  "dependencies": {
    "@endo/base64": "^1.1.1",
    "@endo/bytes": "^1.0.1",
    "@endo/captp": "^4.5.1",
    "@endo/compartment-mapper": "^2.3.0",
    "@endo/errors": "^1.3.1",
    "@endo/eventual-send": "^1.5.0",
    "@endo/exo": "^1.7.0",
    "@endo/far": "^1.1.14",
    "@endo/harden": "^1.1.0",
    "@endo/hex": "^1.1.1",
    "@endo/import-bundle": "^1.7.0",
    "@endo/init": "^1.1.13",
    "@endo/marshal": "^1.10.0",
    "@endo/netstring": "^1.1.1",
    "@endo/patterns": "^2.0.0",
    "@endo/promise-kit": "^1.2.1",
    "@endo/stream": "^1.3.1",
    "@endo/stream-node": "^1.2.1",
    "@endo/where": "^1.0.11",
    "ses": "^2.2.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@endo/bundle-source": "^4.3.2",
    "@endo/pass-style": "^1.8.1",
    "@endo/ses-ava": "^1.4.2",
    "ava": "^8.0.1",
    "c8": "^11.0.0",
    "eslint": "^8.57.1",
    "typescript": "~6.0.3"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/daemon"
    ]
  },
  "ava": {
    "files": [
      "test/**/*.test.*"
    ],
    "timeout": "2m"
  },
  "typeCoverage": {
    "atLeast": 97.21
  }
}
