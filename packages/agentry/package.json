{
  "name": "@endo/agentry",
  "version": "0.1.0",
  "description": "Shared infrastructure for building agentic harnesses across endo packages",
  "keywords": [],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/tree/master/packages/agentry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/agentry"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types-index.types.d.ts",
      "default": "./src/index.js"
    },
    "./harness": {
      "types": "./harness.types.d.ts",
      "default": "./src/harness/index.js"
    },
    "./define-agent": {
      "types": "./define-agent.types.d.ts",
      "default": "./src/define-agent.js"
    },
    "./code-mode": {
      "types": "./code-mode.types.d.ts",
      "default": "./src/code-mode.js"
    },
    "./code-mode-provisioning": {
      "types": "./code-mode-provisioning.types.d.ts",
      "default": "./code-mode-provisioning.js"
    },
    "./harness/types.js": {
      "types": "./src/harness/types-index.types.d.ts",
      "default": "./src/harness/types-index.js"
    },
    "./code-mode/types.js": {
      "types": "./src/code-mode/types-index.types.d.ts",
      "default": "./src/code-mode/types-index.js"
    },
    "./endo-code-mode-pi-extension": {
      "types": "./endo-code-mode-pi-extension.js",
      "default": "./endo-code-mode-pi-extension.js"
    },
    "./eval": {
      "types": "./src/eval/index.types.d.ts",
      "default": "./src/eval/index.js"
    },
    "./edit-text": {
      "types": "./src/edit-text.js",
      "default": "./src/edit-text.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "endo-pi": "./bin/endo-pi.js"
  },
  "scripts": {
    "build": "exit 0",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix && yarn lint:types",
    "lint:eslint": "eslint '**/*.js'",
    "lint:types": "tsc",
    "prepack": "exit 0",
    "test": "ava",
    "test:live": "ava --config ava-live.config.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@endo/agent-tools": "workspace:^",
    "@endo/cancel": "workspace:^",
    "@endo/daemon": "workspace:^",
    "@endo/errors": "workspace:^",
    "@endo/eventual-send": "workspace:^",
    "@endo/exo-git": "workspace:^",
    "@endo/far": "workspace:^",
    "@endo/harden": "workspace:^",
    "@endo/marshal": "workspace:^",
    "@endo/platform": "workspace:^",
    "@endo/where": "workspace:^",
    "ses": "workspace:^"
  },
  "devDependencies": {
    "@endo/exo-stream": "workspace:^",
    "@endo/git": "workspace:^",
    "@endo/init": "workspace:^",
    "@endo/lockdown": "workspace:^",
    "@endo/pass-style": "workspace:^",
    "@endo/patterns": "workspace:^",
    "@endo/platform": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev",
    "fast-check": "^4.9.0",
    "typescript": "catalog:dev"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "bin",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "ava": {
    "files": [
      "test/**/*.test.*",
      "!test/eval-live.test.js"
    ],
    "timeout": "3m"
  }
}
