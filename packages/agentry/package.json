{
  "name": "@endo/agentry",
  "version": "0.1.0",
  "private": true,
  "description": "Shared infrastructure for building agentic harnesses across endo packages",
  "keywords": [],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/tree/master/packages/agentry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/agentry"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "exports": {
    "./code-mode-agent-node": {
      "types": "./src/types/code-mode-agent-node.ts",
      "default": "./src/code-mode-agent-node.js"
    },
    "./code-mode-delegation": {
      "types": "./src/types/code-mode-delegation.ts",
      "default": "./src/code-mode-delegation.js"
    },
    "./code-mode-runtime": {
      "types": "./src/types/code-mode-runtime.ts",
      "default": "./src/code-mode-runtime.js"
    },
    "./lal-code-mode": {
      "types": "./src/types/lal-code-mode.ts",
      "default": "./src/lal-code-mode.js"
    },
    "./lal-code-mode-git-loop": {
      "types": "./src/types/lal-code-mode-git-loop.ts",
      "default": "./src/lal-code-mode-git-loop.js"
    },
    "./pi-extension": {
      "types": "./src/types/pi-extension.ts",
      "default": "./src/pi-extension.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix && yarn lint:types",
    "lint:eslint": "eslint '**/*.js'",
    "lint:types": "tsc",
    "prepack": "exit 0",
    "test": "ava"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.79.0",
    "@earendil-works/pi-ai": "^0.79.0",
    "@endo/agent-tools": "workspace:^",
    "@endo/far": "workspace:^"
  },
  "devDependencies": {
    "@endo/endo-fs": "workspace:^",
    "@endo/exo-git": "workspace:^",
    "@endo/exo-stream": "workspace:^",
    "@endo/git": "workspace:^",
    "@endo/init": "workspace:^",
    "@endo/lockdown": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  },
  "ava": {
    "files": [
      "test/**/*.test.*"
    ],
    "timeout": "2m"
  }
}
