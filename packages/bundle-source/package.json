{
  "name": "@endo/bundle-source",
  "version": "4.3.2",
  "description": "Create source bundles from ES Modules",
  "type": "module",
  "main": "src/index.js",
  "bin": "./src/tool.js",
  "exports": {
    ".": "./src/index.js",
    "./exported.js": "./src/exports.js",
    "./cache.js": "./cache.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "test": "ava",
    "test:xs": "exit 0",
    "lint-fix": "eslint --fix '**/*.js'",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint:eslint": "eslint .",
    "lint:types": "tsc"
  },
  "dependencies": {
    "@endo/base64": "^1.1.1",
    "@endo/compartment-mapper": "^2.3.0",
    "@endo/evasive-transform": "^2.3.0",
    "@endo/harden": "^1.1.0",
    "@endo/init": "^1.1.13",
    "@endo/promise-kit": "^1.2.1",
    "@endo/where": "^1.0.11",
    "amaro": "^1.1.9"
  },
  "devDependencies": {
    "@endo/lockdown": "^1.0.19",
    "@endo/ses-ava": "^1.4.2",
    "@endo/zip": "^1.1.0",
    "ava": "^8.0.1",
    "c8": "^11.0.0",
    "eslint": "^8.57.1",
    "ses": "^2.2.0",
    "typescript": "~6.0.3"
  },
  "keywords": [],
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/bundle-source"
  },
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "homepage": "https://github.com/endojs/endo#readme",
  "publishConfig": {
    "access": "public"
  },
  "ava": {
    "files": [
      "test/**/*.test.*"
    ]
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ],
    "ignorePatterns": [
      "dist/",
      "scripts/",
      "demo/"
    ]
  },
  "typeCoverage": {
    "atLeast": 69.54
  }
}
