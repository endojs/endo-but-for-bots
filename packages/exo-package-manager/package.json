{
  "name": "@endo/exo-package-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Portable guarded facets and backend protocol for package-manager metadata, safe dependency hydration, and project execution.",
  "keywords": [
    "endo",
    "exo",
    "package-manager",
    "npm",
    "pnpm",
    "yarn"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/exo-package-manager"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./types-index.types.d.ts",
  "exports": {
    ".": {
      "types": "./types-index.types.d.ts",
      "default": "./src/index.js"
    },
    "./types-index.js": {
      "types": "./types-index.types.d.ts",
      "default": "./types-index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "test": "ses-ava",
    "test:types": "tsc --project tsconfig.test-types.json",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint:types": "tsc",
    "lint-fix": "yarn lint:eslint --fix",
    "lint:eslint": "eslint '**/*.js'"
  },
  "dependencies": {
    "@endo/errors": "workspace:^",
    "@endo/eventual-send": "workspace:^",
    "@endo/exo": "workspace:^",
    "@endo/far": "workspace:^",
    "@endo/harden": "workspace:^",
    "@endo/patterns": "workspace:^"
  },
  "devDependencies": {
    "@endo/init": "workspace:^",
    "@endo/pass-style": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "@fast-check/ava": "catalog:dev",
    "ava": "catalog:dev",
    "eslint": "catalog:dev",
    "expect-type": "^1.4.0",
    "typescript": "catalog:dev"
  },
  "files": [
    "LICENSE*",
    "SECURITY*",
    "src",
    "types-index.js",
    "types-index.types.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "timeout": "60s"
  },
  "sesAvaConfigs": {
    "lockdown": "../../ava-endo-lockdown.config.mjs",
    "unsafe": "../../ava-endo-lockdown-unsafe.config.mjs",
    "endo": "../../ava-endo-shims-only.config.mjs",
    "noop-harden": "../../ava-base.config.mjs"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  }
}
