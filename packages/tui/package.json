{
  "name": "@endo/tui",
  "version": "0.1.0",
  "private": true,
  "description": "Exo-based CapTP wrapper for endor TUI regions — stub.",
  "keywords": [
    "endo",
    "endor",
    "tui",
    "captp",
    "exo"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/blob/master/packages/tui/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/tui"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./src/tui.types.d.ts",
  "exports": {
    ".": {
      "types": "./src/tui.types.d.ts",
      "default": "./index.js"
    },
    "./interfaces.js": "./src/interfaces.js",
    "./inspector.js": "./src/inspector.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "eslint --fix .",
    "lint:eslint": "eslint .",
    "lint:types": "tsc",
    "test": "ses-ava"
  },
  "dependencies": {
    "@endo/exo": "workspace:^",
    "@endo/harden": "workspace:^",
    "@endo/patterns": "workspace:^",
    "@endo/tui-xs": "workspace:^"
  },
  "devDependencies": {
    "@endo/eventual-send": "workspace:^",
    "@endo/init": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev",
    "ses": "workspace:^",
    "typescript": "catalog:dev"
  },
  "publishConfig": {
    "access": "public"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  },
  "sesAvaConfigs": {
    "lockdown": "../../ava-endo-lockdown.config.mjs",
    "unsafe": "../../ava-endo-lockdown-unsafe.config.mjs",
    "endo": "../../ava-endo-shims-only.config.mjs"
  }
}
