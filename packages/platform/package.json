{
  "name": "@endo/platform",
  "version": "0.1.0",
  "description": "Platform filesystem types and adapters for Endo",
  "keywords": [
    "endo",
    "platform",
    "filesystem"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/tree/master/packages/platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/platform"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "exports": {
    "./blob": "./src/blob.js",
    "./fs": {
      "node": "./src/fs-node/index.js"
    },
    "./fs/lite": "./src/fs/index.js",
    "./fs/lite/types": {
      "types": "./src/fs/types-index.d.ts"
    },
    "./fs/lite/types.js": {
      "types": "./src/fs/types-index.d.ts"
    },
    "./fs/node": "./src/fs-node/index.js",
    "./fs/node/read-file-window": "./src/fs-node/read-file-window.js",
    "./fs/search": "./src/fs/search.js",
    "./fs/search.types": {
      "types": "./src/fs/search-types-index.d.ts"
    },
    "./fs/search.types.js": {
      "types": "./src/fs/search-types-index.d.ts"
    },
    "./fs/node/search": "./src/fs-node/search-powers.js",
    "./fs/extended": {
      "types": "./src/fs/extended/types-index.types.d.ts",
      "default": "./src/fs/extended/index.js"
    },
    "./fs/extended/types-index.js": {
      "types": "./src/fs/extended/types-index.types.d.ts",
      "default": "./src/fs/extended/types-index.js"
    },
    "./fs/extended/backend-types": {
      "types": "./src/fs/extended/backend-types-index.d.ts"
    },
    "./fs/extended/backend-types.js": {
      "types": "./src/fs/extended/backend-types-index.d.ts"
    },
    "./fs/extended/*": "./src/fs/extended/*",
    "./proc": "./src/proc.js",
    "./exo-fs": "./src/exo-fs.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "eslint --fix .",
    "lint:eslint": "eslint .",
    "lint:types": "tsc",
    "test": "ava",
    "test:types": "tsc --project tsconfig.test-types.json"
  },
  "dependencies": {
    "@endo/base64": "workspace:^",
    "@endo/bytes": "workspace:^",
    "@endo/errors": "workspace:^",
    "@endo/eventual-send": "workspace:^",
    "@endo/exo": "workspace:^",
    "@endo/exo-stream": "workspace:^",
    "@endo/far": "workspace:^",
    "@endo/harden": "workspace:^",
    "@endo/hex": "workspace:^",
    "@endo/init": "workspace:^",
    "@endo/patterns": "workspace:^",
    "@endo/sha256": "workspace:^",
    "@endo/stream": "workspace:^",
    "@endo/stream-node": "workspace:^"
  },
  "devDependencies": {
    "@endo/captp": "workspace:^",
    "@endo/pass-style": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev",
    "expect-type": "^1.4.0",
    "typescript": "catalog:dev"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "ava": {
    "files": [
      "test/**/*.test.*"
    ],
    "timeout": "2m"
  }
}
