  "dependencies": {
    "@endo/harden": "workspace:^",
    "ses": "workspace:^"
  },
  "devDependencies": {
    "eslint": "catalog:dev",
    "tsd": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src",
    "tools"
