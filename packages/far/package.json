{
  "name": "@endo/far",
  "version": "1.1.14",
  "description": "Helpers for distributed objects.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "ses-ava",
    "test:c8": "c8 ${C8_OPTIONS:-} ses-ava",
    "test:xs": "exit 0",
    "build": "exit 0",
    "lint-fix": "npm run lint:eslint --fix && npm run lint:types",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint:types": "tsc",
    "lint:eslint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/far"
  },
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "homepage": "https://github.com/endojs/endo#readme",
  "dependencies": {
    "@endo/errors": "^1.3.1",
    "@endo/eventual-send": "^1.5.0",
    "@endo/harden": "^1.1.0",
    "@endo/pass-style": "^1.8.1"
  },
  "devDependencies": {
    "@endo/init": "^1.1.13",
    "@endo/ses-ava": "^1.4.2",
    "ava": "^8.0.1",
    "c8": "^11.0.0",
    "eslint": "^8.57.1",
    "ses": "^2.2.0",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "eventual send",
    "wavy dot",
    "remote objects",
    "tildot",
    "far"
  ],
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src",
    "tools"
  ],
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "sesAvaConfigs": {
    "lockdown": "../../ava-endo-lockdown.config.mjs",
    "unsafe": "../../ava-endo-lockdown-unsafe.config.mjs",
    "endo": "../../ava-endo-shims-only.config.mjs"
  },
  "typeCoverage": {
    "atLeast": 100
  }
}
