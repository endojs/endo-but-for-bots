{
  "name": "@endo/claude-sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "Direct Anthropic Messages subscription inference for Endo.",
  "keywords": [],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/claude-sandbox"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "exports": {
    "./src/container-mount-bridge.js": "./src/container-mount-bridge.js",
    "./package.json": "./package.json",
    "./setup-direct.js": "./setup-direct.js"
  },
  "scripts": {
    "build": "exit 0",
    "test": "ava",
    "lint": "yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix",
    "lint:eslint": "eslint '**/*.js'",
    "setup:direct": "endo run --UNCONFINED setup-direct.js --powers @agent",
    "login:direct": "node login.js"
  },
  "dependencies": {
    "@endo/errors": "workspace:^",
    "@endo/eventual-send": "workspace:^",
    "@endo/exo": "workspace:^",
    "@endo/hosted-agent": "workspace:^",
    "@endo/init": "workspace:^",
    "@endo/patterns": "workspace:^",
    "@endo/platform": "workspace:^"
  },
  "devDependencies": {
    "@endo/cli": "workspace:^",
    "@endo/far": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev"
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "timeout": "60s"
  }
}
