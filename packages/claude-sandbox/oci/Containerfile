# Claude CLI overlay on the shared development tool image.
# Build with: sh packages/claude-sandbox/oci/build.sh
# Network/mount authority is supplied by the external sandbox policy.
ARG ENDO_DEV_IMAGE
FROM ${ENDO_DEV_IMAGE}

RUN npm install -g @anthropic-ai/claude-code@2.1.233 \
  && claude --version | grep -q '^2.1.233 ' \
  && rm -rf /root/.npm /root/.claude /tmp/node-compile-cache

COPY capture-compaction.mjs /opt/endo/capture-compaction.mjs
COPY restore-context.mjs /opt/endo/restore-context.mjs
COPY native-context-projection.mjs /opt/endo/native-context-projection.mjs

WORKDIR /workspace
