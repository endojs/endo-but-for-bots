{
  "name": "@endo/exo-dynamodb",
  "version": "0.1.0",
  "description": "Recursively attenuated DynamoDB object capabilities",
  "keywords": [
    "endo",
    "exo",
    "dynamodb",
    "object-capability"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/tree/master/packages/exo-dynamodb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/exo-dynamodb"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./types.types.d.ts",
  "exports": {
    ".": {
      "types": "./types.types.d.ts",
      "default": "./index.js"
    },
    "./marshal.js": "./src/marshal.js",
    "./type-guards.js": "./src/type-guards.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix && yarn lint:types",
    "lint:eslint": "eslint '**/*.js'",
    "lint:types": "tsc",
    "prepack": "git clean -fX -e node_modules/ && tsc --build tsconfig.build.json",
    "postpack": "git clean -fX -e node_modules/",
    "test": "ava",
    "test:c8": "c8 ${C8_OPTIONS:-} ava",
    "test:xs": "exit 0"
  },
  "dependencies": {
    "@endo/base64": "workspace:^",
    "@endo/errors": "workspace:^",
    "@endo/exo": "workspace:^",
    "@endo/hex": "workspace:^",
    "@endo/pass-style": "workspace:^",
    "@endo/patterns": "workspace:^",
    "@endo/sha256": "workspace:^",
    "@endo/utf8": "workspace:^"
  },
  "devDependencies": {
    "@endo/init": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "ava": "catalog:dev",
    "c8": "catalog:dev",
    "eslint": "catalog:dev",
    "fast-check": "^4.10.2",
    "typescript": "catalog:dev"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "./*.ts",
    "LICENSE*",
    "SECURITY*",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "ava": {
    "files": [
      "test/**/*.test.*"
    ],
    "timeout": "2m"
  }
}
