{
  "name": "@endo/npm-registry-server",
  "version": "0.1.0",
  "private": true,
  "description": "npm-protocol registry server for staged development releases, backed by a content-addressed store and SQLite registry tables",
  "keywords": [
    "endo",
    "npm",
    "registry",
    "cas"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/tree/master/packages/npm-registry-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/npm-registry-server"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "bin": {
    "npm-registry-admin": "./bin/npm-registry-admin.js",
    "npm-registry-server": "./bin/npm-registry-server.js"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix && yarn lint:types",
    "lint:eslint": "eslint '**/*.js'",
    "lint:types": "tsc",
    "prepack": "git clean -fX -e node_modules/ && tsc --build tsconfig.build.json",
    "postpack": "git clean -fX -e node_modules/",
    "test": "ava",
    "test:c8": "c8 ${C8_OPTIONS:-} ava",
    "test:xs": "exit 0"
  },
  "dependencies": {
    "@endo/errors": "workspace:^",
    "@endo/init": "workspace:^",
    "@endo/tar": "workspace:^",
    "better-sqlite3": "^12.0.0"
  },
  "devDependencies": {
    "@endo/ses-ava": "workspace:^",
    "@fast-check/ava": "catalog:dev",
    "@types/node": "catalog:dev",
    "ava": "catalog:dev",
    "c8": "catalog:dev",
    "eslint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "ava": {
    "files": [
      "test/**/*.test.*"
    ],
    "timeout": "5m"
  }
}
