{
  "name": "@endo/thixotrope-harness",
  "version": "0.1.0",
  "private": true,
  "description": "The Endo daemon harness (hosted AI-assistant sessions) built on Thixotrope: guest vat programs, native resources, scripts and perf checks",
  "keywords": [
    "thixotrope",
    "ocapn",
    "agent",
    "harness"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/tree/master/packages/thixotrope-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/thixotrope-harness"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "bundle": "node scripts/bundle-guest.mjs",
    "lint": "yarn lint:types && yarn lint:eslint && yarn lint:duplicates",
    "lint:duplicates": "node scripts/check-duplicates.mjs",
    "lint-fix": "yarn lint:eslint --fix",
    "lint:eslint": "eslint .",
    "lint:types": "tsc",
    "perf": "node perf/_harness.mjs",
    "test": "ses-ava",
    "test:integration": "THIX_HARNESS_INTEGRATION=1 node scripts/test-integration.mjs",
    "test:c8": "c8 ${C8_OPTIONS:-} ses-ava",
    "test:xs": "exit 0",
    "build:ui": "node ui/build.mjs",
    "test:browser": "THIX_HARNESS_BROWSER=1 THIX_HARNESS_INTEGRATION=1 node scripts/test-integration.mjs"
  },
  "dependencies": {
    "@endo/captp": "workspace:^",
    "@endo/compartment-mapper": "workspace:^",
    "@endo/far": "workspace:^",
    "@endo/harden": "workspace:^",
    "@endo/init": "workspace:^",
    "@endo/marshal": "workspace:^",
    "@endo/thixotrope": "workspace:^",
    "preact": "^10.29.8",
    "ses": "workspace:^",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@endo/ses-ava": "workspace:^",
    "@playwright/test": "^1.64.1",
    "ava": "catalog:dev",
    "c8": "catalog:dev",
    "esbuild": "^0.28.2",
    "eslint": "catalog:dev",
    "happy-dom": "^20.14.6",
    "typescript": "catalog:dev"
  },
  "files": [],
  "sesAvaConfigs": {
    "lockdown": "../../ava-endo-lockdown.config.mjs"
  }
}
