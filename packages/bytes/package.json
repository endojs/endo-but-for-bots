{
  "name": "@endo/bytes",
  "version": "1.0.1",
  "description": "Portable Uint8Array helpers for cross-realm byte handling",
  "keywords": [
    "uint8array",
    "bytes",
    "endo",
    "ses"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/blob/master/packages/bytes/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/bytes"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "exports": {
    "./equals.js": "./equals.js",
    "./from-string.js": "./from-string.js",
    "./to-string.js": "./to-string.js",
    "./concat.js": "./concat.js",
    "./concat-immutables.js": "./concat-immutables.js",
    "./from-immutable.js": "./from-immutable.js",
    "./to-immutable.js": "./to-immutable.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "prepack": "git clean -fX -e node_modules/ && tsc --build tsconfig.build.json",
    "postpack": "git clean -fX -e node_modules/",
    "cover": "c8 ses-ava",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint-fix": "eslint --fix .",
    "lint:eslint": "eslint .",
    "lint:types": "tsc",
    "test": "ses-ava"
  },
  "dependencies": {
    "@endo/harden": "^1.1.0",
    "@endo/immutable-arraybuffer": "^1.1.2"
  },
  "devDependencies": {
    "@endo/eventual-send": "^1.5.0",
    "@endo/init": "^1.1.13",
    "@endo/pass-style": "^1.8.1",
    "@endo/ses-ava": "^1.4.2",
    "ava": "^8.0.1",
    "babel-eslint": "^10.1.0",
    "c8": "^11.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "ses": "^2.2.0",
    "typescript": "~6.0.3"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  },
  "sesAvaConfigs": {
    "lockdown": "../../ava-endo-lockdown.config.mjs",
    "unsafe": "../../ava-endo-lockdown-unsafe.config.mjs",
    "endo": "../../ava-endo-shims-only.config.mjs"
  },
  "typeCoverage": {
    "atLeast": 95
  }
}
