{
  "name": "@endo/sha256",
  "version": "1.0.0",
  "description": "Platform-neutral synchronous SHA-256 over bytes",
  "keywords": [
    "sha256",
    "sha-256",
    "hash",
    "digest",
    "endo",
    "ses"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/blob/master/packages/sha256/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/sha256"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./src/sha256-node.js",
  "exports": {
    ".": {
      "xs": "./src/sha256-endor.js",
      "browser": "./src/sha256-browser.js",
      "node": "./src/sha256-node.js",
      "default": "./src/sha256-browser.js"
    },
    "./src/sha256-js.js": "./src/sha256-js.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "prepack": "git clean -fX -e node_modules/ && tsc --build tsconfig.build.json",
    "postpack": "git clean -fX -e node_modules/",
    "cover": "c8 ava",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "eslint --fix .",
    "lint:eslint": "eslint .",
    "lint:types": "tsc",
    "test": "ava"
  },
  "dependencies": {
    "@endo/harden": "workspace:^",
    "@endo/hex": "workspace:^"
  },
  "devDependencies": {
    "@fast-check/ava": "catalog:dev",
    "ava": "catalog:dev",
    "babel-eslint": "^10.1.0",
    "c8": "catalog:dev",
    "eslint": "catalog:dev",
    "prettier": "^3.9.6",
    "typescript": "catalog:dev"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "timeout": "120s"
  },
  "typeCoverage": {
    "atLeast": 95
  }
}
