{
  "name": "@endo/sha256",
  "version": "1.0.0",
  "description": "Platform-neutral one-shot SHA-256 hash over binary buffers",
  "keywords": [
    "sha256",
    "hash",
    "crypto",
    "endo",
    "ses"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/blob/master/packages/sha256/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/sha256"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "exports": {
    ".": {
      "browser": "./sha256-browser.js",
      "node": "./sha256-node.js",
      "xs": "./sha256-xs.js",
      "default": "./sha256-node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "eslint --fix .",
    "lint:eslint": "eslint .",
    "lint:types": "tsc",
    "test": "ses-ava"
  },
  "dependencies": {
    "@endo/harden": "workspace:^"
  },
  "devDependencies": {
    "@endo/init": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev",
    "prettier": "^3.5.3",
    "ses": "workspace:^",
    "typescript": "catalog:dev"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  },
  "sesAvaConfigs": {
    "lockdown": "../../ava-endo-lockdown.config.mjs",
    "unsafe": "../../ava-endo-lockdown-unsafe.config.mjs",
    "endo": "../../ava-endo-shims-only.config.mjs"
  },
  "typeCoverage": {
    "atLeast": 95
  }
}
