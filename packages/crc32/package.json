{
  "name": "@endo/crc32",
  "version": "0.1.0",
  "description": "Hardened synchronous IEEE CRC-32 over bytes",
  "keywords": [
    "crc32",
    "crc-32",
    "checksum",
    "endo",
    "ses"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/blob/master/packages/crc32/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/crc32"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "prepack": "git clean -fX -e node_modules/ && tsc --build tsconfig.build.json",
    "postpack": "git clean -fX -e node_modules/",
    "cover": "c8 ava",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "eslint --fix .",
    "lint:eslint": "eslint .",
    "lint:types": "tsc",
    "test": "ava",
    "test:xs": "exit 0"
  },
  "dependencies": {
    "@endo/harden": "workspace:^"
  },
  "devDependencies": {
    "@endo/utf8": "workspace:^",
    "ava": "catalog:dev",
    "c8": "catalog:dev",
    "eslint": "catalog:dev",
    "prettier": "^3.9.6",
    "typescript": "catalog:dev"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "README.md",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "timeout": "2m"
  },
  "typeCoverage": {
    "atLeast": 100
  }
}
