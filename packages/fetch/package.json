{
  "name": "@endo/fetch",
  "version": "0.0.0",
  "private": true,
  "description": "Unconfined Endo plugin that adapts the worker's ambient fetch into a passable, unfettered Fetch capability. Integrations retain it and endow it to @endo/confined-fetch, which attenuates it into a policy-bound HttpClient for guests.",
  "keywords": [
    "endo",
    "exo",
    "fetch",
    "http",
    "plugin"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/fetch"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./timer.js": "./src/timer.js",
    "./src/types.js": "./src/types.js",
    "./package.json": "./package.json"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "src"
  ],
  "scripts": {
    "build": "exit 0",
    "test": "ava",
    "lint": "yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix",
    "lint:eslint": "eslint '**/*.js'"
  },
  "dependencies": {
    "@endo/cancel": "workspace:^",
    "@endo/errors": "workspace:^",
    "@endo/exo": "workspace:^",
    "@endo/exo-stream": "workspace:^",
    "@endo/patterns": "workspace:^",
    "@endo/utf8": "workspace:^"
  },
  "devDependencies": {
    "@endo/eventual-send": "workspace:^",
    "@endo/immutable-arraybuffer": "workspace:^",
    "@endo/promise-kit": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev"
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "timeout": "120s"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  }
}
