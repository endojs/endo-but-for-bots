{
  "name": "@endo/import-bundle",
  "version": "1.7.0",
  "description": "load modules created by @endo/bundle-source",
  "keywords": [],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/tree/master/packages/import-bundle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/import-bundle"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "engines": {
    "node": ">=12"
  },
  "exports": {
    ".": "./src/index.js",
    "./source-map-node.js": "./source-map-node.js",
    "./source-map-node-powers.js": "./source-map-node-powers.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "ses-ava",
    "test:c8": "c8 ${C8_OPTIONS:-} ses-ava",
    "test:xs": "exit 0",
    "build": "exit 0",
    "lint-fix": "eslint --fix '**/*.js'",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint:eslint": "eslint .",
    "lint:types": "tsc"
  },
  "dependencies": {
    "@endo/base64": "^1.1.1",
    "@endo/compartment-mapper": "^2.3.0",
    "@endo/errors": "^1.3.1",
    "@endo/harden": "^1.1.0",
    "@endo/where": "^1.0.11",
    "ses": "^2.2.0"
  },
  "devDependencies": {
    "@endo/bundle-source": "^4.3.2",
    "@endo/evasive-transform": "^2.3.0",
    "@endo/eventual-send": "^1.5.0",
    "@endo/init": "^1.1.13",
    "@endo/ses-ava": "^1.4.2",
    "ava": "^8.0.1",
    "c8": "^11.0.0",
    "eslint": "^10.4.1",
    "typescript": "~6.0.3"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "ava": {
    "require": [
      "@endo/ses-ava/prepare-endo-config.js"
    ],
    "files": [
      "test/**/*.test.*"
    ],
    "timeout": "2m"
  },
  "sesAvaConfigs": {
    "lockdown": "../../ava-endo-lockdown.config.mjs",
    "unsafe": "../../ava-endo-lockdown-unsafe.config.mjs",
    "endo": "../../ava-endo-shims-only.config.mjs"
  },
  "typeCoverage": {
    "atLeast": 65.38
  }
}
