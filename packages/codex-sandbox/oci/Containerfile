# Containerfile — a "just works" image for @endo/codex-sandbox.
#
# It carries node + the Codex CLI plus a general programming toolchain,
# so Codex can run typical coding tasks and install new dependencies
# (npm / pip / node-gyp native modules) inside the sandbox as work requires.
#
# The session runs this with `network: 'private'` by default: NAT'd outbound
# internet — so package installs and the OpenAI API work — with no route to
# the host or its LAN (RFC 1918 + loopback are blocklisted). There is no host
# networking.
#
# Build, tag, and point the factory at it:
#
#   podman build -t localhost/codex:latest \
#     -f packages/codex-sandbox/oci/Containerfile packages/codex-sandbox/oci
#
#   # Then either set the daemon default:
#   #   CODEX_SANDBOX_IMAGE=oci:localhost/codex:latest
#   # or pass per session:
#   #   rootfs: "oci:localhost/codex:latest"

FROM docker.io/library/node:22-bookworm-slim

# General programming toolchain + what native npm modules and pip need:
#   - ca-certificates + curl : HTTPS to package registries and the API
#   - git                    : the backbone of most coding workflows
#   - ripgrep                : the fast search Codex Code shells out to
#   - build-essential python3: node-gyp / native addons, pip packages
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    ripgrep \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
  && rm -rf /var/lib/apt/lists/*

# The Codex CLI on PATH. `npm install -g` inside a running session also
# lands here (/usr/local/bin is already on PATH), so Codex can add global
# tools as needed.
RUN npm install -g @openai/codex

# CODEX_HOME is a read/write host bind. It contains auth.json and config.toml;
# the CLI refreshes ChatGPT-managed credentials in place. The workspace
# Filesystem is bind-mounted separately here.
WORKDIR /workspace
