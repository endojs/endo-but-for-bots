# Containerfile — a "just works" image for @endo/codex-sandbox.
#
# It carries node + the Codex CLI plus a general programming toolchain,
# so Codex can run typical coding tasks and install new dependencies
# (npm / pip / node-gyp native modules) inside the sandbox as work requires.
#
# Network, mount, and resource policy are supplied by the external slice
# provisioner. This image makes no isolation claim on its own.
#
# Build, tag, and point the factory at it:
#
#   podman build -t localhost/codex:latest \
#     -f packages/codex-sandbox/oci/Containerfile packages/codex-sandbox/oci
#
#   # Then either set the daemon default:
#   #   CODEX_SANDBOX_IMAGE=oci:localhost/codex:latest
#   # or pass per session:
#   #   rootfs: "oci:localhost/codex:latest"

FROM docker.io/library/node:22.19.0-bookworm-slim

# General programming toolchain + what native npm modules and pip need:
#   - ca-certificates + curl : HTTPS to package registries and the API
#   - git                    : the backbone of most coding workflows
#   - ripgrep                : the fast search Codex Code shells out to
#   - build-essential python3: node-gyp / native addons, pip packages
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    ripgrep \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
  && rm -rf /var/lib/apt/lists/*

# Install the pinned Codex CLI before dropping privileges.
RUN npm install -g "@openai/codex@0.152.0" \
  && test "$(codex --version)" = "codex-cli 0.152.0"

# CODEX_HOME is disposable per-session state, not a credential boundary:
# commands launched by Codex run as this same node UID and can read it by
# absolute path. Never put auth.json, a reusable token, or a machine-wide Codex
# home here. Hosted authentication requires a broker/proxy outside this slice.
RUN mkdir -p /codex-home /workspace \
  && chown node:node /codex-home /workspace
ENV CODEX_HOME=/codex-home
USER node
WORKDIR /workspace
