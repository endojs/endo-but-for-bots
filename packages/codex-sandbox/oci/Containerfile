# Containerfile — a "just works" image for @endo/codex-sandbox.
#
# It carries node + the Codex CLI plus a general programming toolchain,
# so Codex can run typical coding tasks and build already-vendored dependencies
# (npm / pip / node-gyp native modules). The production broker-only network does
# not grant package-registry access unless a separate Endo capability does so.
#
# Network, mount, and resource policy are supplied by the external slice
# provisioner. This image makes no isolation claim on its own.
#
# Build, tag, and point the factory at it:
#
#   packages/codex-sandbox/oci/build-reproducible.sh \
#     localhost/codex:0.152.0
#
#   # Then either set the daemon default:
#   #   CODEX_SANDBOX_IMAGE=oci:localhost/codex@sha256:<built-digest>
#   # or pass per session:
#   #   rootfs: "oci:localhost/codex@sha256:<built-digest>"

FROM docker.io/library/node:22.19.0-bookworm-slim@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90

ENV LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  TZ=UTC \
  SOURCE_DATE_EPOCH=1757376000

# General programming toolchain + what native npm modules and pip need:
#   - ca-certificates + curl : HTTPS to package registries and the API
#   - git                    : the backbone of most coding workflows
#   - ripgrep                : the fast search Codex Code shells out to
#   - build-essential python3: node-gyp / native addons, pip packages
# Use an immutable Debian snapshot. The base digest and snapshot timestamp are
# reviewed together; Check-Valid-Until is disabled because snapshots do not
# move their Release-file clock forward.
RUN sed -i \
      -e 's|deb.debian.org/debian-security|snapshot.debian.org/archive/debian-security/20250908T000000Z|g' \
      -e 's|deb.debian.org/debian|snapshot.debian.org/archive/debian/20250908T000000Z|g' \
      /etc/apt/sources.list.d/debian.sources \
  && ! grep -q 'deb.debian.org' /etc/apt/sources.list.d/debian.sources \
  && grep -q 'snapshot.debian.org/archive/debian-security/20250908T000000Z' \
      /etc/apt/sources.list.d/debian.sources \
  && grep -q 'snapshot.debian.org/archive/debian/20250908T000000Z' \
      /etc/apt/sources.list.d/debian.sources \
  && printf 'Acquire::Check-Valid-Until "false";\n' \
      > /etc/apt/apt.conf.d/99snapshot \
  && apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    ripgrep \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
  && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/log/apt/* \
  && : > /var/log/dpkg.log \
  && : > /var/log/alternatives.log

# Install exactly the lockfile-resolved Codex CLI and platform binary before
# dropping privileges. npm verifies every downloaded artifact against the
# checked-in integrity hashes.
COPY package.json package-lock.json /opt/codex-install/
RUN cd /opt/codex-install \
  && npm ci --ignore-scripts --omit=dev \
  && ln -s /opt/codex-install/node_modules/.bin/codex /usr/local/bin/codex \
  && test "$(codex --version)" = "codex-cli 0.152.0" \
  && rm -rf /root/.npm

# CODEX_HOME is session-durable until teardown, not a credential boundary.
# Commands launched by Codex run as this same node UID and may read it, while
# the mandatory workspaceWrite turn policy denies modification outside the
# explicit workspace/tmp roots. Never put auth.json, a reusable token, or a
# machine-wide Codex home here. Hosted authentication requires a broker/proxy
# outside this slice.
RUN mkdir -p /codex-home /workspace \
  && chown node:node /codex-home /workspace
ENV CODEX_HOME=/codex-home
USER node
WORKDIR /workspace
