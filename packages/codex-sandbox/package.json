{
  "name": "@endo/codex-sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "Direct OpenAI Responses subscription inference for Endo.",
  "keywords": [],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/codex-sandbox"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "exports": {
    "./src/codex-broker-service-agent.js": "./src/codex-broker-service-agent.js",
    "./package.json": "./package.json",
    "./setup-direct.js": "./setup-direct.js"
  },
  "scripts": {
    "build": "exit 0",
    "test": "ava",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix",
    "lint:eslint": "eslint '**/*.js'",
    "lint:types": "tsc",
    "setup:direct": "endo run --UNCONFINED setup-direct.js --powers @agent"
  },
  "dependencies": {
    "@endo/errors": "workspace:^",
    "@endo/eventual-send": "workspace:^",
    "@endo/hosted-agent": "workspace:^",
    "@endo/patterns": "workspace:^"
  },
  "devDependencies": {
    "@endo/cli": "workspace:^",
    "@endo/far": "workspace:^",
    "@endo/init": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "timeout": "60s"
  }
}
