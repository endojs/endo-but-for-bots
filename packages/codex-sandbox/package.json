{
  "name": "@endo/codex-sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "Run Codex CLI inside an @endo/sandbox podman slice with a projected workspace, durable machine auth, and an Endo MCP bridge.",
  "keywords": [],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/codex-sandbox"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "exports": {
    "./setup-host.js": "./setup-host.js",
    "./setup-hosted.js": "./setup-hosted.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "test": "ava",
    "setup:host": "endo run --UNCONFINED setup-host.js --powers @agent",
    "setup:hosted": "endo run --UNCONFINED setup-hosted.js --powers @agent",
    "lint": "yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix",
    "lint:eslint": "eslint '**/*.js'"
  },
  "dependencies": {
    "@endo/9p-server": "workspace:^",
    "@endo/daemon": "workspace:^",
    "@endo/errors": "workspace:^",
    "@endo/eventual-send": "workspace:^",
    "@endo/exo": "workspace:^",
    "@endo/exo-stream": "workspace:^",
    "@endo/init": "workspace:^",
    "@endo/patterns": "workspace:^",
    "@endo/platform": "workspace:^",
    "@endo/sandbox": "workspace:^",
    "@endo/stream": "workspace:^"
  },
  "devDependencies": {
    "@endo/cli": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev"
  },
  "ava": {
    "files": [
      "test/**/*.test.js",
      "!test/live-daemon.test.js",
      "!test/ninep-flow.test.js"
    ],
    "timeout": "60s"
  }
}
