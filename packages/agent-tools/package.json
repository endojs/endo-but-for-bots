{
  "name": "@endo/agent-tools",
  "version": "0.0.1",
  "description": "Provider-independent agent tool catalog for Endo, including capability-scoped filesystem tools backed by an @endo/platform/fs/extended Filesystem",
  "keywords": [],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/agent-tools"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "types": "./types-index.types.d.ts",
  "exports": {
    ".": {
      "types": "./types-index.types.d.ts",
      "default": "./types-index.js"
    },
    "./pi": {
      "types": "./pi.types.d.ts",
      "default": "./src/adapters/pi.js"
    },
    "./tool.js": {
      "types": "./tool.types.d.ts",
      "default": "./src/tool.js"
    },
    "./workspace.js": {
      "types": "./workspace.types.d.ts",
      "default": "./src/workspace.js"
    },
    "./json-tools/git.js": {
      "types": "./json-tools/git.types.d.ts",
      "default": "./src/json-tools/git.js"
    },
    "./json-tools/git-mount.js": {
      "types": "./json-tools/git-mount.types.d.ts",
      "default": "./src/json-tools/git-mount.js"
    },
    "./json-tools/git-remote.js": {
      "types": "./json-tools/git-remote.types.d.ts",
      "default": "./src/json-tools/git-remote.js"
    },
    "./json-tools/fs.js": {
      "types": "./json-tools/fs.types.d.ts",
      "default": "./src/json-tools/fs.js"
    },
    "./json-tools/shell.js": {
      "types": "./json-tools/shell.types.d.ts",
      "default": "./src/json-tools/shell.js"
    },
    "./json-tools/http.js": {
      "types": "./json-tools/http.types.d.ts",
      "default": "./src/json-tools/http.js"
    },
    "./code-mode/evaluate-tool.js": {
      "types": "./code-mode/evaluate-tool.types.d.ts",
      "default": "./src/code-mode/evaluate-tool.js"
    },
    "./code-mode/compartment.js": {
      "types": "./src/code-mode/compartment.js",
      "default": "./src/code-mode/compartment.js"
    },
    "./code-mode/daemon.js": {
      "types": "./src/code-mode/daemon.js",
      "default": "./src/code-mode/daemon.js"
    },
    "./code-mode/declarations.js": {
      "types": "./src/code-mode/declarations.js",
      "default": "./src/code-mode/declarations.js"
    },
    "./code-mode-globals/git.js": {
      "types": "./src/code-mode-globals/git.js",
      "default": "./src/code-mode-globals/git.js"
    },
    "./code-mode-globals/fs.js": {
      "types": "./src/code-mode-globals/fs.js",
      "default": "./src/code-mode-globals/fs.js"
    },
    "./code-mode-globals/fs-seams.js": {
      "types": "./src/code-mode-globals/fs-seams.js",
      "default": "./src/code-mode-globals/fs-seams.js"
    },
    "./code-mode-globals/shell.js": {
      "types": "./src/code-mode-globals/shell.js",
      "default": "./src/code-mode-globals/shell.js"
    },
    "./code-mode-globals/http.js": {
      "types": "./src/code-mode-globals/http.js",
      "default": "./src/code-mode-globals/http.js"
    },
    "./code-mode-globals/git-remote.js": {
      "types": "./src/code-mode-globals/git-remote.js",
      "default": "./src/code-mode-globals/git-remote.js"
    },
    "./adapters/pi.js": {
      "types": "./adapters/pi.types.d.ts",
      "default": "./src/adapters/pi.js"
    },
    "./code-mode/types.js": {
      "types": "./src/code-mode/types-index.types.d.ts",
      "default": "./src/code-mode/types-index.js"
    },
    "./adapters/smallcaps.js": {
      "types": "./src/adapters/smallcaps.js",
      "default": "./src/adapters/smallcaps.js"
    },
    "./adapters/mcp.js": {
      "types": "./src/adapters/mcp.js",
      "default": "./src/adapters/mcp.js"
    },
    "./generated/code-mode-globals/git-declarations.js": {
      "types": "./generated/code-mode-globals/git-declarations.js",
      "default": "./generated/code-mode-globals/git-declarations.js"
    },
    "./generated/code-mode-globals/fs-declarations.js": {
      "types": "./generated/code-mode-globals/fs-declarations.js",
      "default": "./generated/code-mode-globals/fs-declarations.js"
    },
    "./generated/code-mode-globals/shell-declarations.js": {
      "types": "./generated/code-mode-globals/shell-declarations.js",
      "default": "./generated/code-mode-globals/shell-declarations.js"
    },
    "./generated/code-mode-globals/http-declarations.js": {
      "types": "./generated/code-mode-globals/http-declarations.js",
      "default": "./generated/code-mode-globals/http-declarations.js"
    },
    "./generated/code-mode-globals/git-remote-declarations.js": {
      "types": "./generated/code-mode-globals/git-remote-declarations.js",
      "default": "./generated/code-mode-globals/git-remote-declarations.js"
    },
    "./types-index.js": {
      "types": "./types-index.types.d.ts",
      "default": "./types-index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "gen:code-mode-types": "node scripts/gen-code-mode-types.js",
    "test": "ava",
    "test:c8": "c8 ${C8_OPTIONS:-} ava",
    "test:types": "tsc --project tsconfig.test-types.json",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix",
    "lint:eslint": "eslint '**/*.js'",
    "lint:types": "tsc"
  },
  "publishConfig": {
    "access": "public"
  },
  "ava": {
    "files": [
      "test/**/*.test.*"
    ],
    "timeout": "2m"
  },
  "dependencies": {
    "@endo/eventual-send": "workspace:^",
    "@endo/exo-git": "workspace:^",
    "@endo/exo-http-client": "workspace:^",
    "@endo/exo-shell": "workspace:^",
    "@endo/far": "workspace:^",
    "@endo/marshal": "workspace:^",
    "@endo/pass-style": "workspace:^",
    "@endo/patterns": "workspace:^",
    "@endo/platform": "workspace:^"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@endo/daemon": "workspace:^",
    "@endo/git": "workspace:^",
    "@endo/host-spawner": "workspace:^",
    "@endo/immutable-arraybuffer": "workspace:^",
    "@endo/init": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "ajv": "^8.17.1",
    "ava": "catalog:dev",
    "c8": "catalog:dev",
    "eslint": "catalog:dev",
    "expect-type": "^1.4.0",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  }
}
