{
  "name": "@endo/field-voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Field agent (Agent C) — voice/text Endo-capability chat platform. Server is plain node ESM; the client is incrementally migrating to confined-Preact islands (see designs/preact-component-trie.md).",
  "scripts": {
    "build:islands": "vite build --config vite.islands.config.js",
    "build:ses-shim": "yarn workspace @endo/ses-test build:ses-vanilla && cp ../../ses/dist/ses.umd.min.js public/ses.umd.min.js",
    "test": "node --test",
    "test:theme": "node theme-matrix.staging.test.cjs",
    "test:confinement": "node confinement.staging.test.cjs",
    "test:lockdown": "node lockdown-survive.staging.test.cjs",
    "test:forks": "node forks-loop.staging.test.cjs",
    "test:fork-widget": "node fork-widget.staging.test.cjs",
    "test:alt-fork": "node alt-click-fork.staging.test.cjs",
    "test:component-select": "node component-select.staging.test.cjs",
    "test:shape": "node shape-graph.staging.test.cjs",
    "test:trace": "node trace-fanout.staging.test.cjs",
    "test:agent-menu": "node agent-menu.staging.test.cjs",
    "test:fork-upgrade": "node fork-upgrade.staging.test.cjs",
    "test:dist-trust": "node --test dist-trust.test.mjs",
    "test:fork-distribution": "node fork-distribution.staging.test.cjs",
    "test:paste-link": "node paste-link.staging.test.cjs",
    "test:raw-context": "node raw-context.staging.test.cjs",
    "test:file-editor": "node file-editor.staging.test.cjs"
  },
  "dependencies": {
    "@endo/exo-git": "workspace:^",
    "@endo/git": "workspace:^",
    "@endo/preact-container": "workspace:^",
    "preact": "^10.29.2",
    "ses": "workspace:^"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
