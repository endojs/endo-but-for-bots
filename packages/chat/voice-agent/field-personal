#!/usr/bin/env bash
# field-personal — manage dan's ENCRYPTED PERSONAL VOLUME for Agent C (Packing up for Dweb, P5).
#
# The keystone: Agent C runs in PLATFORM mode (no secrets, clean multi-tenant) unless this LUKS volume
# is decrypted with YOUR passphrase and mounted. There is NO keyfile on the host — the machine cannot
# unlock it; only you can. Decrypt + mount → PERSONAL mode (your vault, secrets, root cap, admin caps
# load FROM the volume). Pull the drive → none of it is on the box.
#
# SAFETY: nothing here is automatic. The destructive steps (`init`, `scrub`) and the passphrase steps
# (`init`, `unlock`) refuse to run without an explicit confirmation token, and `scrub` refuses until it
# has VERIFIED a good copy exists on the volume. Run `field-personal status` any time to see where you stand.
#
# The drive is laid out as TWO regions (see designs/packing-up-for-dweb.md, "The provisioner drive"):
#   • a plaintext BOOTABLE archua deploy image + agent docs (provisions fresh instances), and
#   • this LUKS PERSONAL PARTITION (dan's secrets/vault/state). `init` operates on the PARTITION, so the
#     deploy image on the rest of the drive is untouched.
#
#   field-personal status                 — mode, mount state, what (if anything) is still plaintext on disk
#   sudo field-personal init   <part>     — DESTRUCTIVE: LUKS-format the PERSONAL PARTITION (e.g. /dev/sdX2)
#   sudo field-personal unlock            — decrypt (asks your passphrase) + mount + switch service to personal
#   sudo field-personal lock              — unmount + close + switch service back to platform
#        field-personal migrate           — copy the personal data from the internal disk → the mounted volume
#        field-personal verify            — confirm the volume holds a complete, readable copy
#   sudo field-personal scrub  --yes      — DESTRUCTIVE: securely erase the plaintext originals from the disk
#
# Typical first-time flow (you run these; the agent built the tool):
#   sudo field-personal init /dev/sdX2  →  sudo field-personal unlock  →  field-personal migrate
#   →   field-personal verify   →   (sanity-check personal mode works)   →   sudo field-personal scrub --yes
# Thereafter each session: plug the drive, `sudo field-personal unlock`; when done, `sudo field-personal lock`.

set -euo pipefail

# Resolve the REAL operator's home even under sudo (sudo sets HOME=/root). Everything personal — the
# data sources, the metadata file, the service owner — keys off the invoking user, never root.
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
  HOME_DIR="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
  OWNER="$SUDO_USER"
else
  HOME_DIR="${HOME:-/home/dan}"
  OWNER="$(id -un)"
fi
MAPPER="field-personal"                 # /dev/mapper/field-personal when unlocked
MOUNT="${FIELD_PERSONAL_MOUNT:-/mnt/field-personal}"
META="$HOME_DIR/.config/field-agent-volume.json"   # NON-secret: just the LUKS UUID of YOUR drive (no key)
SVC="voice-agent"
LABEL="field-personal"
# Off-site backup target (the sibling Unraid box, same place archua + muddle back up). The backup is
# ENCRYPTED on this host before it leaves, so friky holds only ciphertext — never the plaintext secrets.
FRIKY_HOST="${FRIKY_HOST:-root@192.168.50.74}"
FRIKY_BACKUP_DIR="${FRIKY_BACKUP_DIR:-/mnt/user/dan/backups/field-personal}"
BACKUP_KEEP="${BACKUP_KEEP:-7}"   # how many timestamped backups to retain on friky

# The personal data set: { source on the internal disk → sub-path on the volume }. Mirrors field-config.mjs
# (CONFIG_DIR/STATE_DIR/VOICE_STATE_DIR/DASH_STATE_DIR/VAULT_DIR) so the service finds everything via
# FIELD_PERSONAL_ROOT. `env` is a copy of the keys the voice-agent itself needs (see note in `migrate`).
declare -A MAP=(
  ["$HOME_DIR/.config/field-agent"]="config"
  ["$HOME_DIR/.config/kazputer-phone"]="config/kazputer-phone"
  ["$HOME_DIR/.config/gator-pay"]="config/gator-pay"
  ["$HOME_DIR/.local/state/field-agent"]="state/field-agent"
  ["$HOME_DIR/.local/state/voice-agent"]="state/voice-agent"
  ["$HOME_DIR/.local/state/field-dashboard"]="state/field-dashboard"
  ["$HOME_DIR/obsidian/vault"]="vault"
)

c_red() { printf '\033[31m%s\033[0m\n' "$*"; }
c_grn() { printf '\033[32m%s\033[0m\n' "$*"; }
c_ylw() { printf '\033[33m%s\033[0m\n' "$*"; }
die()   { c_red "✗ $*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "this step needs root — re-run with: sudo field-personal $*"; }

is_mounted() { mountpoint -q "$MOUNT" 2>/dev/null; }
is_open()    { [ -e "/dev/mapper/$MAPPER" ]; }
vol_uuid()   { [ -f "$META" ] && sed -n 's/.*"luksUUID"[: ]*"\([^"]*\)".*/\1/p' "$META" | head -1; }

cmd_status() {
  echo "── Agent C personal volume ─────────────────────────────"
  local uuid; uuid="$(vol_uuid || true)"
  echo "  known drive (LUKS UUID): ${uuid:-«not initialized — run init»}"
  if is_open; then c_grn "  LUKS mapping:   OPEN  (/dev/mapper/$MAPPER)"; else echo "  LUKS mapping:   closed"; fi
  if is_mounted; then c_grn "  mounted at:     $MOUNT"; else echo "  mounted at:     (not mounted)"; fi
  if _binds_active; then c_grn "  bind-mounts:    ACTIVE (the whole box reads the volume)"; else echo "  bind-mounts:    none"; fi
  local mode="platform"; if [ -f "$HOME_DIR/.config/field-agent/root.swiss" ]; then mode="personal"; fi
  echo "  → service mode: $mode  (keyed on root.swiss presence at the home config path)"
  echo
  echo "── Plaintext personal data STILL on the internal (unencrypted) disk ──"
  local any=0
  for src in "${!MAP[@]}"; do
    mountpoint -q "$src" 2>/dev/null && continue   # BOUND = the encrypted volume showing through, NOT a plaintext original
    if [ -e "$src" ] && [ -n "$(ls -A "$src" 2>/dev/null || true)" ]; then any=1; printf '  %-7s %s\n' "$(du -sh "$src" 2>/dev/null | cut -f1)" "$src"; fi
  done
  [ -f "$HOME_DIR/.env" ] && { any=1; printf '  %-7s %s  (host-wide — shared with other services; see checklist)\n' "$(du -sh "$HOME_DIR/.env" | cut -f1)" "$HOME_DIR/.env"; }
  if [ "$any" = 0 ]; then c_grn "  none — all secrets live only on the encrypted volume ✓"; else c_ylw "  ↑ these are readable WITHOUT the drive. Run migrate → verify → scrub to remove them."; fi
}

cmd_init() {
  need_root init "$@"
  local dev="${1:-}"; [ -n "$dev" ] || die "usage: sudo field-personal init /dev/sdX2   (the LUKS PARTITION, not the whole drive — it will be ERASED)"
  [ -b "$dev" ] || die "$dev is not a block device"
  command -v cryptsetup >/dev/null || die "cryptsetup not installed"
  # refuse to touch the system disk OR a whole-disk device (we want a PARTITION so the deploy image survives)
  local root_src; root_src="$(findmnt -no SOURCE / 2>/dev/null || true)"
  case "$root_src" in *"$(basename "$dev")"*) die "$dev backs the root filesystem — refusing";; esac
  case "$dev" in /dev/sd[a-z]|/dev/nvme[0-9]n[0-9]|/dev/mmcblk[0-9]) c_ylw "  ⚠  $dev looks like a WHOLE disk, not a partition. The plan is a partition (e.g. ${dev}2) so the"; c_ylw "      bootable deploy image on the rest of the drive survives. Continue ONLY if you meant whole-disk.";; esac
  echo; c_red "  ⚠  THIS ERASES EVERYTHING ON $dev:"; lsblk "$dev" -o NAME,SIZE,FSTYPE,LABEL || true
  echo; read -r -p "  Type the device name to confirm ERASE (e.g. $(basename "$dev")): " ans
  [ "$ans" = "$(basename "$dev")" ] || die "confirmation mismatch — aborted (nothing erased)"
  echo; c_ylw "  You will now set the volume PASSPHRASE. ONLY YOU will know it. The host stores no key — without"
  c_ylw "  this passphrase, the data is unrecoverable and the machine cannot decrypt it. Choose it well."
  echo
  cryptsetup --type luks2 --label "$LABEL" luksFormat "$dev"      # interactive: you set the passphrase
  echo; c_ylw "  Re-enter the passphrase to open it for first-time setup:"
  cryptsetup open "$dev" "$MAPPER"
  mkfs.ext4 -q -L "$LABEL" "/dev/mapper/$MAPPER"
  mkdir -p "$MOUNT"; mount "/dev/mapper/$MAPPER" "$MOUNT"
  mkdir -p "$MOUNT/config" "$MOUNT/state" "$MOUNT/vault"
  printf '{\n  "user": "dan",\n  "created": "%s",\n  "note": "Agent C personal volume — presence here = personal mode"\n}\n' "$(date -u +%FT%TZ)" > "$MOUNT/personal.json"
  chown -R "$(stat -c %u "$HOME_DIR"):$(stat -c %g "$HOME_DIR")" "$MOUNT"
  local uuid; uuid="$(cryptsetup luksUUID "$dev")"
  printf '{ "luksUUID": "%s", "label": "%s", "mount": "%s" }\n' "$uuid" "$LABEL" "$MOUNT" > "$META"
  chown "$(stat -c %u "$HOME_DIR"):$(stat -c %g "$HOME_DIR")" "$META"
  c_grn "✓ initialized. LUKS UUID $uuid recorded in $META (no key stored). Now: field-personal migrate"
}

_resolve_dev() {
  local uuid; uuid="$(vol_uuid || true)"; [ -n "$uuid" ] || die "no known drive — run init first"
  local dev; dev="$(blkid -t UUID="$uuid" -o device 2>/dev/null | head -1 || true)"
  [ -n "$dev" ] || die "the personal drive (LUKS UUID $uuid) is not plugged in"
  echo "$dev"
}

# raw mount of the LUKS volume (used by init/migrate/verify/scrub AND as the bind SOURCE)
_mount_raw() {
  is_open || { local dev; dev="$(_resolve_dev)"; c_ylw "  Enter your volume passphrase:"; cryptsetup open "$dev" "$MAPPER"; }
  is_mounted || { mkdir -p "$MOUNT"; mount "/dev/mapper/$MAPPER" "$MOUNT"; }
}
# BIND the volume's subdirs OVER their home locations, so EVERY consumer on the box (Agent C, the dashboard,
# the vault, the muddle …) transparently reads the volume — not just things that honor FIELD_PERSONAL_ROOT.
_bind_on() {
  for src in "${!MAP[@]}"; do
    local vol="$MOUNT/${MAP[$src]}"
    [ -d "$vol" ] || continue
    runuser -u "$OWNER" -- mkdir -p "$src"
    mountpoint -q "$src" || mount --bind "$vol" "$src"
  done
}
# unbind the home paths. A bind held open by a process (the service, the vault syncer, a shell cwd) refuses a
# plain umount → fall back to a LAZY umount (detaches now; open FDs keep the old inode, new accesses see the
# underlying real dir). Safe: lazy-detaching a bind never touches the volume's data at /mnt.
_bind_off() { for src in "${!MAP[@]}"; do mountpoint -q "$src" || continue; umount "$src" 2>/dev/null || umount -l "$src" 2>/dev/null || true; done; }
_binds_active() { for src in "${!MAP[@]}"; do mountpoint -q "$src" && return 0; done; return 1; }

cmd_unlock() {
  need_root unlock
  _mount_raw
  [ -f "$MOUNT/personal.json" ] || c_ylw "  (mounted, but no personal.json yet — run migrate first)"
  _bind_on
  _restart_service
  c_grn "✓ unlocked: volume bound over your home paths → $SVC in PERSONAL mode (the WHOLE box reads the volume)"
}

cmd_lock() {
  need_root lock
  _bind_off
  is_mounted && umount "$MOUNT" 2>/dev/null || true
  is_open && cryptsetup close "$MAPPER" 2>/dev/null || true
  _restart_service
  c_grn "✓ locked — binds removed, drive closed; $SVC restarted (platform mode once originals are scrubbed)"
}

# With the bind model the service just reads the HOME paths (which the binds make = the volume) — no
# FIELD_PERSONAL_ROOT needed. Clear any legacy drop-in + restart so field-config re-resolves; mode follows
# whether root.swiss is present (bound → present → personal; locked+scrubbed → absent → platform).
_restart_service() {
  local owner="$OWNER" uid; uid="$(id -u "$owner")"
  runuser -u "$owner" -- rm -f "$HOME_DIR/.config/systemd/user/$SVC.service.d/personal-mode.conf" 2>/dev/null || true
  runuser -u "$owner" -- env XDG_RUNTIME_DIR="/run/user/$uid" systemctl --user daemon-reload || true
  runuser -u "$owner" -- env XDG_RUNTIME_DIR="/run/user/$uid" systemctl --user restart "$SVC" || true
}

cmd_migrate() {
  _binds_active && die "the volume is BOUND over your home paths — run 'sudo field-personal lock' first (migrate must read the real originals, not the volume through a bind)"
  is_mounted || die "the volume is not mounted — open it: sudo cryptsetup open <part> field-personal && sudo mount /dev/mapper/field-personal /mnt/field-personal"
  command -v rsync >/dev/null || die "rsync not installed"
  # Some targets NEST under another (e.g. config/kazputer-phone + config/gator-pay live under config/, which
  # is itself the target of ~/.config/field-agent). A naive `--delete` on the parent would wipe the nested
  # child copied from a DIFFERENT source. So for each sync we EXCLUDE any other target nested beneath it →
  # order-independent + correct.
  local -a dsts=(); for s in "${!MAP[@]}"; do dsts+=("${MAP[$s]}"); done
  for src in "${!MAP[@]}"; do
    [ -e "$src" ] || continue
    local rel="${MAP[$src]}"; local dst="$MOUNT/$rel"; mkdir -p "$dst"
    local -a ex=()
    for other in "${dsts[@]}"; do
      case "$other" in "$rel"/*) ex+=( "--exclude=/${other#"$rel"/}" );; esac
    done
    c_ylw "  copying $src → $dst${ex[*]:+  (keeping nested: ${ex[*]//--exclude=\//})}"
    rsync -a --delete "${ex[@]}" "$src"/ "$dst"/
  done
  # The keys the VOICE-AGENT itself needs (the agent's own inference + HA), copied to a volume-local env so
  # personal mode reads them FROM the drive. This is a SUBSET of the host-wide ~/.env (which other services
  # share) — scrubbing the host ~/.env is a separate, flagged decision (see the checklist).
  if [ -f "$HOME_DIR/.env" ]; then
    grep -E '^(ANTHROPIC_API_KEY|OPENROUTER_API_KEY|PERPLEXITY_API_KEY|HOMEASSISTANT|VLLM_API_KEY|OCOB_VLLM_)' "$HOME_DIR/.env" > "$MOUNT/env" 2>/dev/null || true
    chmod 600 "$MOUNT/env"
    c_grn "  wrote the voice-agent's own keys → $MOUNT/env (subset of host ~/.env)"
  fi
  c_grn "✓ migrate complete. Next: field-personal verify"
}

cmd_verify() {
  is_mounted || die "the volume is not mounted — run: sudo field-personal unlock"
  local ok=1
  [ -f "$MOUNT/personal.json" ] || { c_red "  ✗ personal.json missing on the volume"; ok=0; }
  for src in "${!MAP[@]}"; do
    [ -e "$src" ] || continue
    local dst="$MOUNT/${MAP[$src]}"
    if [ ! -d "$dst" ]; then c_red "  ✗ missing on volume: ${MAP[$src]}"; ok=0; continue; fi
    # compare file counts as a cheap completeness check
    local sc dc; sc="$(find "$src" -type f 2>/dev/null | wc -l)"; dc="$(find "$dst" -type f 2>/dev/null | wc -l)"
    if [ "$dc" -ge "$sc" ]; then printf '  \033[32m✓\033[0m %-26s %s files\n' "${MAP[$src]}" "$dc"; else c_red "  ✗ ${MAP[$src]}: volume has $dc < $sc on disk"; ok=0; fi
  done
  [ -f "$HOME_DIR/.config/field-agent/root.swiss" ] && { [ -f "$MOUNT/config/root.swiss" ] && c_grn "  ✓ root.swiss present on volume" || { c_red "  ✗ root.swiss NOT on volume"; ok=0; }; }
  if [ "$ok" = 1 ]; then c_grn "✓ verify PASSED — the volume holds a complete copy. Safe to scrub the originals."; else die "verify FAILED — do NOT scrub; re-run migrate."; fi
}

cmd_scrub() {
  need_root scrub "$@"
  [ "${1:-}" = "--yes" ] || die "scrub is DESTRUCTIVE — re-run: sudo field-personal scrub --yes (after a passing verify)"
  is_mounted || die "the volume must be mounted at $MOUNT so scrub can re-verify the copy before deleting (sudo field-personal unlock)"
  echo; c_red "  ⚠  This permanently removes the plaintext personal data from the internal disk."
  c_red "      (A verified copy is on the encrypted volume; this erases only the unencrypted originals.)"
  read -r -p "  Type ERASE-ORIGINALS to confirm: " ans; [ "$ans" = "ERASE-ORIGINALS" ] || die "aborted (nothing erased)"
  # 1. STOP the service so it releases the bound home paths, THEN unbind (lazy fallback for other holders).
  local owner uid; owner="$OWNER"; uid="$(id -u "$owner")"
  c_ylw "  stopping $SVC so it releases the bound paths…"
  runuser -u "$owner" -- env XDG_RUNTIME_DIR="/run/user/$uid" systemctl --user stop "$SVC" || true
  sleep 1; _bind_off; sleep 1
  # 2. CRITICAL SAFETY: every home path must now be UNBOUND, or shred would erase the VOLUME through a bind.
  _binds_active && { c_red "  could not unbind every home path (still busy)."; c_ylw "  recover with: sudo $0 unlock"; die "refusing to scrub while any bind remains"; }
  # 3. FINAL RECONCILE (not a brittle count-verify): ~17 other services write these paths, so the moment we
  #    unbind one may touch an original. Rather than race a strict verify, capture any drift onto the volume
  #    NEWEST-WINS (no --delete → never clobber the live chats/purses the volume already holds), so nothing is
  #    lost. Then gate the shred on a REAL completeness signal: the root cap is present on the volume.
  c_ylw "  reconciling any last-moment drift onto the volume (newest-wins)…"
  for src in "${!MAP[@]}"; do [ -e "$src" ] || continue; mountpoint -q "$src" && continue; rsync -a --update "$src"/ "$MOUNT/${MAP[$src]}"/ 2>/dev/null || true; done
  [ -f "$MOUNT/config/root.swiss" ] || { c_ylw "  recover with: sudo $0 unlock"; die "root.swiss not on the volume — aborting (the copy is not complete)"; }
  for src in "${!MAP[@]}"; do
    [ -e "$src" ] || continue
    mountpoint -q "$src" && { c_red "  ✗ $src is a mountpoint — SKIPPING (never shred through a bind)"; continue; }
    c_ylw "  shredding $src"
    find "$src" -type f -exec shred -u -n1 {} + 2>/dev/null || true
    rm -rf "$src"
  done
  c_grn "✓ originals erased from the internal disk. The personal data now lives ONLY on the encrypted volume."
  c_ylw "  NOTE: ~/.env is host-wide (other services read it) — NOT scrubbed here. Decide its fate separately."
  # 4. re-bind + restart so the box comes straight back up in personal mode (no manual unlock needed).
  c_ylw "  re-binding the volume + restarting $SVC…"
  _bind_on; _restart_service
  c_grn "✓ back up in PERSONAL mode — the whole box reads the encrypted volume; nothing personal is on the disk."
}

# OFF-SITE backup → friky. Default `backup` images the raw LUKS PARTITION (already ciphertext under YOUR
# passphrase) → compress → friky. No passphrase needed to MAKE it (so it's automatable); restore = write it
# back + `cryptsetup open` with your LUKS passphrase. friky only ever holds an opaque encrypted blob.
# `backup-file` is the alternative: a smaller gpg-encrypted tar of the decrypted contents (interactive passphrase).
cmd_backup() {
  command -v zstd >/dev/null || die "zstd not installed"
  local dev; dev="$(_resolve_dev)"   # the LUKS partition for our known drive (by UUID)
  ssh -o ConnectTimeout=8 "$FRIKY_HOST" "mkdir -p '$FRIKY_BACKUP_DIR'" >/dev/null 2>&1 || die "can't reach friky ($FRIKY_HOST)"
  local stamp name; stamp="$(date +%Y%m%d-%H%M%S 2>/dev/null || echo manual)"; name="field-personal-$stamp.luks.zst"
  echo; c_ylw "  imaging the ENCRYPTED partition $dev → $FRIKY_HOST:$FRIKY_BACKUP_DIR/$name"
  c_ylw "  (ciphertext — friky cannot read it; restore needs your LUKS passphrase. ~10-15 min to read the partition.)"
  if sudo dd if="$dev" bs=4M 2>/dev/null | zstd -T0 -3 -q \
       | ssh "$FRIKY_HOST" "cat > '$FRIKY_BACKUP_DIR/$name.part' && mv '$FRIKY_BACKUP_DIR/$name.part' '$FRIKY_BACKUP_DIR/$name'"; then
    local sz; sz="$(ssh "$FRIKY_HOST" "du -h '$FRIKY_BACKUP_DIR/$name' | cut -f1" 2>/dev/null || echo '?')"
    c_grn "✓ backup complete: $FRIKY_HOST:$FRIKY_BACKUP_DIR/$name ($sz, ciphertext)"
    ssh "$FRIKY_HOST" "ls -1t '$FRIKY_BACKUP_DIR'/field-personal-*.luks.zst 2>/dev/null | tail -n +$((BACKUP_KEEP+1)) | xargs -r rm -f" 2>/dev/null || true
    c_ylw "  RESTORE: ssh $FRIKY_HOST cat '$FRIKY_BACKUP_DIR/$name' | zstd -d | sudo dd of=<a 100G+ partition> bs=4M ; sudo cryptsetup open <that partition> field-personal  (your LUKS passphrase)"
  else
    ssh "$FRIKY_HOST" "rm -f '$FRIKY_BACKUP_DIR/$name.part'" 2>/dev/null || true
    die "backup failed (no partial kept) — re-run"
  fi
}

# Smaller, file-level alternative: gpg-encrypted tar of the DECRYPTED volume (needs your passphrase, interactive).
cmd_backup_file() {
  is_mounted || die "unlock the volume first: sudo field-personal unlock"
  command -v gpg >/dev/null || die "gpg not installed"; command -v zstd >/dev/null || die "zstd not installed"
  ssh -o ConnectTimeout=8 "$FRIKY_HOST" "mkdir -p '$FRIKY_BACKUP_DIR'" >/dev/null 2>&1 || die "can't reach friky ($FRIKY_HOST)"
  local stamp name; stamp="$(date +%Y%m%d-%H%M%S 2>/dev/null || echo manual)"; name="field-personal-$stamp.tar.zst.gpg"
  echo; c_ylw "  ENCRYPTED backup → $FRIKY_HOST:$FRIKY_BACKUP_DIR/$name"
  c_ylw "  You'll set a BACKUP PASSPHRASE — REMEMBER IT (it can be your LUKS passphrase). It is the only way to"
  c_ylw "  restore, and it survives losing the drive. friky receives ciphertext only; it cannot read your secrets."
  echo
  # tar the decrypted volume → compress → encrypt (symmetric, prompts on YOUR terminal) → stream to friky.
  if tar -C "$MOUNT" --exclude=./lost+found -cf - . | zstd -T0 -q \
       | gpg --symmetric --cipher-algo AES256 --pinentry-mode loopback -o - \
       | ssh "$FRIKY_HOST" "cat > '$FRIKY_BACKUP_DIR/$name.part' && mv '$FRIKY_BACKUP_DIR/$name.part' '$FRIKY_BACKUP_DIR/$name'"; then
    local sz; sz="$(ssh "$FRIKY_HOST" "du -h '$FRIKY_BACKUP_DIR/$name' | cut -f1" 2>/dev/null || echo '?')"
    c_grn "✓ backup complete: $FRIKY_HOST:$FRIKY_BACKUP_DIR/$name ($sz, ciphertext)"
    # retain the newest $BACKUP_KEEP, prune older
    ssh "$FRIKY_HOST" "ls -1t '$FRIKY_BACKUP_DIR'/field-personal-*.tar.zst.gpg 2>/dev/null | tail -n +$((BACKUP_KEEP+1)) | xargs -r rm -f" 2>/dev/null || true
    c_ylw "  RESTORE: ssh $FRIKY_HOST cat '$FRIKY_BACKUP_DIR/$name' | gpg -d | zstd -d | tar -C <target-dir> -xf -"
  else
    ssh "$FRIKY_HOST" "rm -f '$FRIKY_BACKUP_DIR/$name.part'" 2>/dev/null || true
    die "backup failed (no partial kept) — re-run"
  fi
}

case "${1:-status}" in
  status)  cmd_status ;;
  init)    shift; cmd_init "$@" ;;
  unlock)  cmd_unlock ;;
  lock)    cmd_lock ;;
  migrate) cmd_migrate ;;
  verify)  cmd_verify ;;
  scrub)   shift; cmd_scrub "$@" ;;
  backup)  cmd_backup ;;
  backup-file) cmd_backup_file ;;
  *) echo "usage: field-personal {status|init <part>|unlock|lock|migrate|verify|scrub --yes|backup|backup-file}"; exit 1 ;;
esac
