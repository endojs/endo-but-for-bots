{
  "name": "@endo/ext4",
  "version": "0.1.0",
  "description": "Read-only, lazy ext2/3/4 filesystem reader exposing an Endo fs object",
  "keywords": [
    "ext4",
    "ext2",
    "ext3",
    "filesystem",
    "readable tree",
    "endo",
    "ses"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/blob/master/packages/ext4/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/ext4"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./src/*": {
      "test-endo-ext4": "./src/*"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "prepack": "git clean -fX -e node_modules/ && tsc --build tsconfig.build.json",
    "postpack": "git clean -fX -e node_modules/",
    "cover": "c8 ses-ava",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "eslint --fix .",
    "lint:eslint": "eslint .",
    "lint:types": "tsc",
    "test": "ses-ava"
  },
  "dependencies": {
    "@endo/base64": "workspace:^",
    "@endo/block-device": "workspace:^",
    "@endo/errors": "workspace:^",
    "@endo/exo": "workspace:^",
    "@endo/exo-stream": "workspace:^",
    "@endo/harden": "workspace:^",
    "@endo/platform": "workspace:^",
    "@endo/stream": "workspace:^",
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@endo/eventual-send": "workspace:^",
    "@endo/init": "workspace:^",
    "@endo/luks": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "ava": "catalog:dev",
    "babel-eslint": "^10.1.0",
    "c8": "catalog:dev",
    "eslint": "catalog:dev",
    "prettier": "^3.5.3",
    "ses": "workspace:^",
    "typescript": "catalog:dev"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  },
  "sesAvaConfigs": {
    "lockdown": "../../ava-endo-lockdown.config.mjs",
    "unsafe": "../../ava-endo-lockdown-unsafe.config.mjs",
    "endo": "../../ava-endo-shims-only.config.mjs"
  },
  "typeCoverage": {
    "atLeast": 85
  }
}
