{
  "name": "@endo/nat",
  "version": "5.2.0",
  "description": "Ensures that a number is within the natural numbers (0, 1, 2...) or throws a RangeError",
  "main": "./src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint-fix": "eslint --fix .",
    "lint:eslint": "eslint .",
    "lint:types": "tsc",
    "test": "ses-ava",
    "test:c8": "c8 ${C8_OPTIONS:-} ses-ava"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/nat"
  },
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "homepage": "https://github.com/endojs/endo#readme",
  "devDependencies": {
    "@endo/compartment-mapper": "^2.3.0",
    "@endo/eventual-send": "^1.5.0",
    "@endo/ses-ava": "^1.4.2",
    "ava": "^8.0.1",
    "c8": "^11.0.0",
    "eslint": "^10.4.1",
    "ses": "^2.2.0",
    "typescript": "~6.0.3"
  },
  "directories": {
    "test": "test"
  },
  "keywords": [
    "integer",
    "int",
    "overflow"
  ],
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src",
    "tools"
  ],
  "sesAvaConfigs": {
    "lockdown": "../../ava-endo-lockdown.config.mjs",
    "unsafe": "../../ava-endo-lockdown-unsafe.config.mjs",
    "base": "../../ava-base.config.mjs",
    "noop-harden": "../../ava-base.config.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
