{
  "name": "@endo/hex",
  "version": "1.1.1",
  "description": "Transcodes hexadecimal",
  "keywords": [
    "hex",
    "hexadecimal",
    "endo",
    "ses"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/blob/master/packages/hex/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/hex"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./encode.js": "./encode.js",
    "./decode.js": "./decode.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "cover": "c8 ses-ava",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint-fix": "eslint --fix .",
    "lint:eslint": "eslint .",
    "lint:types": "tsc",
    "test": "ses-ava"
  },
  "dependencies": {
    "@endo/harden": "^1.1.0"
  },
  "devDependencies": {
    "@endo/chacha12": "^1.0.0",
    "@endo/eventual-send": "^1.5.0",
    "@endo/init": "^1.1.13",
    "@endo/random": "^1.0.0",
    "@endo/ses-ava": "^1.4.2",
    "ava": "^8.0.1",
    "babel-eslint": "^10.1.0",
    "c8": "^11.0.0",
    "eslint": "^10.4.1",
    "prettier": "^3.5.3",
    "ses": "^2.2.0",
    "typescript": "~6.0.3"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sesAvaConfigs": {
    "lockdown": "../../ava-endo-lockdown.config.mjs",
    "unsafe": "../../ava-endo-lockdown-unsafe.config.mjs",
    "endo": "../../ava-endo-shims-only.config.mjs"
  },
  "typeCoverage": {
    "atLeast": 95
  }
}
