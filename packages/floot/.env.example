# ── LLM provider (factory) — setup-factory.sh ───────────────────────────────
FLOOT_PROVIDER=anthropic
FLOOT_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# Optional. Max reply tokens (positive integer; default 4096).
# FLOOT_MAX_TOKENS=4096
# Optional. Overrides the default system prompt.
# FLOOT_SYSTEM_PROMPT=

# ── Voice caplets — setup-voice.sh ──────────────────────────────────────────
# Text-to-speech (piper). FLOOT_TTS_MODEL is required by setup-voice.sh.
# FLOOT_TTS_MODEL=/absolute/path/to/voice.onnx
# Optional. piper binary (default "piper") and speed multiplier (default 1.0).
# FLOOT_TTS_BINARY=piper
# FLOOT_TTS_SPEED=1.0
# Speech-to-text (moonshine via uv). Optional language (default "en"), uv
# binary (default "uv"), and FLOOT_STT_ENABLE=0 for a TTS-only deployment.
# FLOOT_STT_LANG=en
# FLOOT_STT_UV=uv
# FLOOT_STT_ENABLE=1
# The caplets are provisioned as floot/stt and floot/tts under FLOOT_DIR
# (default "floot"); override it to use another inventory directory.
# FLOOT_DIR=floot
