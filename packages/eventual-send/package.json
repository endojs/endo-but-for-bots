{
  "name": "@endo/eventual-send",
  "version": "1.5.0",
  "description": "Extend a Promise class to implement the eventual-send API",
  "type": "module",
  "main": "src/no-shim.js",
  "scripts": {
    "test": "ava",
    "test:c8": "c8 ${C8_OPTIONS:-} ava",
    "test:xs": "exit 0",
    "build": "exit 0",
    "clean": "git clean -fX -e node_modules/",
    "lint-fix": "pnpm lint:eslint --fix && pnpm lint:types",
    "lint": "pnpm lint:types && pnpm lint:eslint",
    "lint:types": "tsc",
    "lint:eslint": "eslint ."
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/no-shim.js",
    "./shim.js": "./shim.js",
    "./utils.js": "./utils.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/eventual-send"
  },
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "homepage": "https://github.com/endojs/endo#readme",
  "dependencies": {
    "@endo/env-options": "workspace:^",
    "@endo/harden": "workspace:^"
  },
  "devDependencies": {
    "@endo/lockdown": "workspace:^",
    "ava": "^8.0.1",
    "c8": "^11.0.0",
    "eslint": "^8.57.1",
    "ses": "workspace:^",
    "tsd": "^0.33.0",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "eventual send",
    "wavy dot"
  ],
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "ava": {
    "files": [
      "test/**/*.test.*"
    ],
    "timeout": "2m"
  },
  "typeCoverage": {
    "atLeast": 77.81
  }
}
