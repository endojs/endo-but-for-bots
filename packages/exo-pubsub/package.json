{
  "name": "@endo/exo-pubsub",
  "version": "0.1.0",
  "private": true,
  "description": "CapTP bridge layer exposing @endo/pubsub topics, publishers, and subscriptions as remotable exo objects",
  "keywords": [
    "endo",
    "captp",
    "pubsub",
    "topic",
    "subscribe",
    "publish",
    "stream"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/tree/master/packages/exo-pubsub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/exo-pubsub"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./index.js"
    },
    "./subscription-from-reader.js": {
      "types": "./subscription-from-reader.d.ts",
      "default": "./subscription-from-reader.js"
    },
    "./iterate-subscription.js": {
      "types": "./iterate-subscription.d.ts",
      "default": "./iterate-subscription.js"
    },
    "./publisher-from-writer.js": {
      "types": "./publisher-from-writer.d.ts",
      "default": "./publisher-from-writer.js"
    },
    "./iterate-publisher.js": {
      "types": "./iterate-publisher.d.ts",
      "default": "./iterate-publisher.js"
    },
    "./topic-from-subscribe.js": {
      "types": "./topic-from-subscribe.d.ts",
      "default": "./topic-from-subscribe.js"
    },
    "./subscribe-topic.js": {
      "types": "./subscribe-topic.d.ts",
      "default": "./subscribe-topic.js"
    },
    "./type-guards.js": {
      "types": "./type-guards.d.ts",
      "default": "./type-guards.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix && yarn lint:types",
    "lint:eslint": "eslint '**/*.js'",
    "lint:types": "tsc",
    "postpack": "git clean -fX \"*.tsbuildinfo\"",
    "prepack": "tsc --build tsconfig.build.json --noCheck",
    "test": "ava",
    "test:c8": "c8 ${C8_OPTIONS:-} ses-ava",
    "test:xs": "exit 0"
  },
  "dependencies": {
    "@endo/eventual-send": "workspace:^",
    "@endo/exo": "workspace:^",
    "@endo/exo-stream": "workspace:^",
    "@endo/far": "workspace:^",
    "@endo/pass-style": "workspace:^",
    "@endo/patterns": "workspace:^",
    "@endo/promise-kit": "workspace:^",
    "@endo/pubsub": "workspace:^"
  },
  "devDependencies": {
    "@endo/captp": "workspace:^",
    "@endo/lockdown": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "@endo/stream": "workspace:^",
    "ava": "catalog:dev",
    "c8": "catalog:dev",
    "eslint": "catalog:dev",
    "tsd": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  },
  "ava": {
    "files": [
      "test/**/*.test.*"
    ],
    "timeout": "2m"
  }
}
