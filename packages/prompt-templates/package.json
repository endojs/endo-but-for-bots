{
  "name": "@endo/prompt-templates",
  "version": "0.1.0",
  "private": true,
  "description": "Parse, discover, and expand Pi-style markdown prompt templates with {{variable}} placeholders",
  "keywords": [
    "endo",
    "pi",
    "prompt",
    "template",
    "slash-command"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/prompt-templates"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "exports": {
    "./load.js": "./src/load.js",
    "./node.js": "./src/node.js",
    "./parse.js": "./src/parse.js",
    "./substitute.js": "./src/substitute.js",
    "./types.js": {
      "types": "./src/types.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix",
    "lint:eslint": "eslint '**/*.js'",
    "lint:types": "tsc",
    "test": "ava",
    "test:c8": "c8 ${C8_OPTIONS:-} ava"
  },
  "dependencies": {
    "@endo/harden": "workspace:^"
  },
  "devDependencies": {
    "@endo/init": "workspace:^",
    "ava": "catalog:dev",
    "c8": "catalog:dev",
    "eslint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  },
  "ava": {
    "files": [
      "test/**/*.test.*"
    ],
    "timeout": "2m"
  }
}
