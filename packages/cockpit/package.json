{
  "name": "@endo/cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "Garden cockpit — a harness-host web application that operates the garden under capability-confined agent threads",
  "type": "module",
  "main": "./src/index.js",
  "bin": "./bin/cockpit.js",
  "exports": {
    ".": "./src/index.js",
    "./backend/caps": "./src/backend/caps.js",
    "./backend/daemon": "./src/backend/daemon.js",
    "./backend/engine": "./src/backend/engine.js",
    "./backend/profiles": "./src/backend/profiles.js",
    "./backend/registry": "./src/backend/registry.js",
    "./backend/templates": "./src/backend/templates.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix && yarn lint:types",
    "lint:eslint": "eslint --ignore-pattern public '**/*.js'",
    "lint:types": "tsc",
    "start": "node ./bin/cockpit.js",
    "test": "ava"
  },
  "dependencies": {
    "@endo/agentry": "workspace:^",
    "@endo/daemon": "workspace:^",
    "@endo/far": "workspace:^",
    "@endo/init": "workspace:^",
    "@endo/promise-kit": "workspace:^",
    "@endo/where": "workspace:^"
  },
  "devDependencies": {
    "@endo/lockdown": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "files": [
    "bin",
    "public",
    "src"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  },
  "ava": {
    "files": [
      "test/**/*.test.*"
    ],
    "timeout": "2m"
  }
}
