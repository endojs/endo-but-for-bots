{
  "name": "@endo/captp",
  "version": "4.5.1",
  "description": "Capability Transfer Protocol for distributed objects",
  "type": "module",
  "keywords": [
    "agoric",
    "captp",
    "eventual-send"
  ],
  "author": "Endo contributors",
  "homepage": "https://github.com/endojs/endo#readme",
  "license": "Apache-2.0",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "module": "src/index.js",
  "directories": {
    "src": "src",
    "test": "test"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/captp"
  },
  "scripts": {
    "build": "exit 0",
    "test": "ses-ava",
    "test:xs": "exit 0",
    "lint-fix": "npm run lint:eslint --fix && npm run lint:types",
    "lint": "npm run lint:eslint && npm run lint:types",
    "lint:eslint": "eslint .",
    "lint:types": "tsc"
  },
  "devDependencies": {
    "@endo/init": "^1.1.13",
    "@endo/ses-ava": "^1.4.2",
    "ava": "^8.0.1",
    "c8": "^11.0.0",
    "eslint": "^8.57.1",
    "ses": "^2.2.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@endo/errors": "^1.3.1",
    "@endo/eventual-send": "^1.5.0",
    "@endo/harden": "^1.1.0",
    "@endo/marshal": "^1.10.0",
    "@endo/nat": "^5.2.0",
    "@endo/pass-style": "^1.8.1",
    "@endo/promise-kit": "^1.2.1"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sesAvaConfigs": {
    "lockdown": "../../ava-endo-lockdown.config.mjs",
    "unsafe": "../../ava-endo-lockdown-unsafe.config.mjs",
    "endo": "../../ava-endo-shims-only.config.mjs"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  },
  "typeCoverage": {
    "atLeast": 85.14
  }
