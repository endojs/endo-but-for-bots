diff --git a/rust/engine/ironhorse-vm/src/mail_profile.rs b/rust/engine/ironhorse-vm/src/mail_profile.rs
new file mode 100644
index 000000000..c35af5f68
--- /dev/null
+++ b/rust/engine/ironhorse-vm/src/mail_profile.rs
@@ -0,0 +1,24 @@
+//! Experimental wall-clock profiling. Injected only by the mail profiling patch.
+use std::sync::OnceLock;
+use std::time::{Instant, SystemTime, UNIX_EPOCH};
+static ENABLED: OnceLock<bool> = OnceLock::new();
+pub struct Span {
+    name: &'static str,
+    clock: Option<(Instant, f64)>,
+    pub count: u64,
+    pub secondary: u64,
+}
+impl Span {
+    pub fn new(name: &'static str) -> Self {
+        let enabled = *ENABLED.get_or_init(|| std::env::var_os("THIX_MAIL_VM_DETAIL").is_some());
+        Self { name, clock: enabled.then(|| (Instant::now(), SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_secs_f64()*1000.0)), count: 0, secondary: 0 }
+    }
+}
+impl Drop for Span {
+    fn drop(&mut self) {
+        if let Some((clock, start)) = self.clock {
+            let ms = clock.elapsed().as_secs_f64()*1000.0;
+            eprintln!("{{\"kind\":\"mail.vm\",\"pid\":{},\"phase\":\"{}\",\"request\":\"detail\",\"start\":{},\"ms\":{},\"count\":{},\"secondary\":{}}}", std::process::id(), self.name, start, ms, self.count, self.secondary);
+        }
+    }
+}
